                                                                                                          rdf:first "6" ;
                                                                                                          rdf:rest [ rdf:type rdf:List ;
                                                                                                                     rdf:first "7" ;
                                                                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                                                                rdf:first "8" ;
