<http://example.org/OntologyTradecraft/core/hasICAOWeightTurbulenceCategory> a owl:DatatypeProperty ;
    rdfs:label "has ICAO weight turbulence category"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding ICAO weight turbulence category, which is used to determine the wake turbulence separation requirements for aircraft."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range [ 
        a rdfs:Datatype ;
        owl:oneOf ("Super" "Heavy" "Medium" "Light") 
        ] .

<http://example.org/OntologyTradecraft/core/hasAircraftDesignGroup> a owl:DatatypeProperty ;
    rdfs:label "has aircraft design group"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding Aircraft Design Group (ADG) value, which categorizes the aircraft based on its combination of Tail Height and Wingspan."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range [ 
        a rdfs:Datatype ;
        owl:oneOf ("I" "II" "III" "IV" "V") 
        ] .

<http://example.org/OntologyTradecraft/core/hasTaxiwayDesignGroup> a owl:DatatypeProperty ;
    rdfs:label "has taxiway design group"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding Taxiway Design Group (ADG) value, which categorizes the aircraft based on its combination of Main Gear Width and Cockpit to Main Gear Distance."@en ;
