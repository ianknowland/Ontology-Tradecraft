                             skos:definition "A datatype property that relates an information content entity to a string denoting an hourly 25th percentile wage."@en .


###  http://example.org/OntologyTradecraft/core/hasHourly75thPercentileWage
:hasHourly75thPercentileWage rdf:type owl:DatatypeProperty ;
                             rdfs:label "has hourly 75th percentile wage"@en ;
                             skos:definition "A datatype property that relates an information content entity to a string denoting an hourly 75th percentile wage."@en .


###  http://example.org/OntologyTradecraft/core/hasHourly90thPercentileWage
:hasHourly90thPercentileWage rdf:type owl:DatatypeProperty ;
                             rdfs:label "has hourly 90th percentile wage"@en ;
                             skos:definition "A datatype property that relates an information content entity to a string denoting an hourly 90th percentile wage."@en .


###  http://example.org/OntologyTradecraft/core/hasICAOCode
:hasICAOCode rdf:type owl:DatatypeProperty ;
             rdfs:domain cco:ont00001043 ;
             rdfs:range xsd:string ;
             rdfs:label "has ICAO code"@en ;
             skos:definition "A datatype property that relates an aircraft to its corresponding International Civil Aviation Organization (ICAO) code, which is a unique identifier for the aircraft type."@en .


###  http://example.org/OntologyTradecraft/core/hasICAOWeightTurbulenceCategory
:hasICAOWeightTurbulenceCategory rdf:type owl:DatatypeProperty ;
                                 rdfs:domain cco:ont00001043 ;
                                 rdfs:range [ rdf:type rdfs:Datatype ;
                                              owl:oneOf [ rdf:type rdf:List ;
                                                          rdf:first "Heavy" ;
                                                          rdf:rest [ rdf:type rdf:List ;
                                                                     rdf:first "Light" ;
                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                rdf:first "Medium" ;
                                                                                rdf:rest [ rdf:type rdf:List ;
                                                                                           rdf:first "Super" ;
                                                                                           rdf:rest rdf:nil
                                                                                         ]
                                                                              ]
                                                                   ]
                                                        ]
                                            ] ;
                                 rdfs:label "has ICAO weight turbulence category"@en ;
                                 skos:definition "A datatype property that relates an aircraft to its corresponding ICAO weight turbulence category, which is used to determine the wake turbulence separation requirements for aircraft."@en .


###  http://example.org/OntologyTradecraft/core/hasIGroup
:hasIGroup rdf:type owl:DatatypeProperty ;
           rdfs:label "has industry group"@en ;
           skos:definition "A datatype property that relates an information content entity to a string denoting an industry level."@en .


###  http://example.org/OntologyTradecraft/core/hasLAHSOGroup
:hasLAHSOGroup rdf:type owl:DatatypeProperty ;
               rdfs:domain cco:ont00001043 ;
               rdfs:range [ rdf:type rdfs:Datatype ;
                            owl:oneOf [ rdf:type rdf:List ;
                                        rdf:first "1" ;
                                        rdf:rest [ rdf:type rdf:List ;
                                                   rdf:first "10" ;
                                                   rdf:rest [ rdf:type rdf:List ;
