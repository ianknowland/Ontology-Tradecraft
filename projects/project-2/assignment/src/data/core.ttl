@prefix : <http://example.org/OntologyTradecraft/core/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dc11: <http://purl.org/dc/elements/1.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/OntologyTradecraft/core/> a owl:Ontology ;
    owl:imports <https://www.commoncoreontologies.org/CommonCoreOntologiesMerged> , <http://purl.obolibrary.org/obo/bfo.owl> ;
    rdfs:comment "This ontology is a core ontology for Ontology Tradecraft Project 2." ;
    rdfs:label "Ontology Tradecraft Aircraft Core Ontology" .

#=======================
# BFO/CCO Classes
#=======================

<https://www.commoncoreontologies.org/ont00000319> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://www.commoncoreontologies.org/ont00001942> ;
                                                                     owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000995>
                                                                   ] ;
                                                   rdfs:label "Artifact Design"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Prescriptive Information Content Entity that is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of primitive components, satisfying a set of requirements, subject to constraints."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001754> "https://en.wikipedia.org/w/index.php?title=Design&oldid=1063941625"^^xsd:anyURI ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

<https://www.commoncoreontologies.org/ont00000533> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000056> ;
                                                   rdfs:label "Jet Engine"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Reaction Engine that discharges a fast moving jet that generates Thrust by jet propulsion."@en ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Some (most) jet engines utilize turbines, but some do not. Most rocket engines do not utilize turbines, but some do."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001754> "https://en.wikipedia.org/w/index.php?title=Jet_engine&oldid=1060157063"^^xsd:anyURI ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

<http://purl.obolibrary.org/obo/BFO_0000178> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             rdfs:range <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             dc11:identifier "271-BFO" ;
                                             rdfs:label "has continuant part"@en ;
                                             skos:definition "b has continuant part c =Def c continuant part of b"@en ;
                                             skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en .

<https://www.commoncoreontologies.org/ont00001808> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://www.commoncoreontologies.org/ont00000958> ;
                                                   rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                                   rdfs:label "is about"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "x is_about y is a primitive relationship between an instance of Information Content Entity x and an instance of Entity y."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001754> "http://purl.obolibrary.org/obo/IAO_0000136" .
   
<http://purl.obolibrary.org/obo/BFO_0000139> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000132> ;
                                             rdf:type owl:TransitiveProperty ;
                                             rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
                                             rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
                                             dc11:identifier "078-BFO" ;
                                             rdfs:label "temporal part of"@en ;
                                             rdfs:label "is temporal part of"@en ;
                                             skos:definition "b temporal part of c =Def b occurrent part of c & (b and c are temporal regions) or (b and c are spatiotemporal regions & b temporally projects onto an occurrent part of the temporal region that c temporally projects onto) or (b and c are processes or process boundaries & b occupies a temporal region that is an occurrent part of the temporal region that c occupies)"@en ;
                                             skos:example "Your heart beating from 4pm to 5pm today is a temporal part of the process of your heart beating; the 4th year of your life is a temporal part of your life, as is the process boundary which separates the 3rd and 4th years of your life; the first quarter of a game of football is a temporal part of the whole game"@en .

<https://www.commoncoreontologies.org/ont00001961> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000084> ;
                                                   rdfs:domain <https://www.commoncoreontologies.org/ont00000120> ;
                                                   rdfs:range <https://www.commoncoreontologies.org/ont00000253> ;
                                                   rdfs:label "is measurement unit of"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "x is_measurement_unit_of y iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

<https://www.commoncoreontologies.org/ont00001942> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <https://www.commoncoreontologies.org/ont00001808> ;
                                                   rdfs:domain <https://www.commoncoreontologies.org/ont00000965> ;
                                                   rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                                   rdfs:label "prescribes"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "x prescribes y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x serves as a rule or guide for y if y an Occurrent, or x serves as a model for y if y is a Continuant."@en ;
                                                   <http://www.w3.org/2004/02/skos/core#example> "A blueprint prescribes some artifact or facility by being a model for it." ,
                                                                                                 "A professional code of conduct prescribes some realizations of a profession (role) by giving rules for how the bearer should act in those realizations." ,
                                                                                                 "An operations plan prescribes an operation by enumerating the tasks that need to be performed in order to achieve the objectives of the operation." ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

<https://www.commoncoreontologies.org/ont00000120> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                                   rdfs:label "Measurement Unit"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001754> "https://en.wikipedia.org/w/index.php?title=Unit_of_measurement&oldid=1061038125"^^xsd:anyURI ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

<http://purl.obolibrary.org/obo/BFO_0000055> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
                                             rdfs:range <http://purl.obolibrary.org/obo/BFO_0000017> ;
                                             dc11:identifier "059-BFO" ;
                                             rdfs:label "realizes"@en ;
                                             skos:definition "(Elucidation) realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c"@en ;
                                             skos:example "A balding process realizes a disposition to go bald; a studying process realizes a student role; a process of pumping blood realizes the pumping function of a heart"@en .

<https://www.commoncoreontologies.org/ont00001816> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000056> ;
                                                   owl:inverseOf <https://www.commoncoreontologies.org/ont00001986> ;
                                                   rdfs:domain [ rdf:type owl:Class ;
                                                                 owl:unionOf ( <http://purl.obolibrary.org/obo/BFO_0000020>
                                                                               <http://purl.obolibrary.org/obo/BFO_0000031>
                                                                               [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000004>
                                                                                                      [ rdf:type owl:Class ;
                                                                                                        owl:complementOf <http://purl.obolibrary.org/obo/BFO_0000006>
                                                                                                      ]
                                                                                                    ) ;
                                                                                 rdf:type owl:Class
                                                                               ]
                                                                             )
                                                               ] ;
                                                   rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
                                                   rdfs:label "is output of"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "x is output of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the end of y is a necessary condition for the completion of y."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

<https://www.commoncoreontologies.org/ont00000319> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://www.commoncoreontologies.org/ont00001942> ;
                                                                     owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000995>
                                                                   ] ;
                                                   rdfs:label "Artifact Design"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Prescriptive Information Content Entity that is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of primitive components, satisfying a set of requirements, subject to constraints."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001754> "https://en.wikipedia.org/w/index.php?title=Design&oldid=1063941625"^^xsd:anyURI ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

<http://purl.obolibrary.org/obo/BFO_0000197> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000195> ;
                                             rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000020> ;
                                             rdfs:range [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000004>
                                                                               [ rdf:type owl:Class ;
                                                                                 owl:complementOf <http://purl.obolibrary.org/obo/BFO_0000006>
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                             dc11:identifier "051-BFO" ;
                                             rdfs:label "inheres in"@en ;
                                             skos:definition "b inheres in c =Def b is a specifically dependent continuant & c is an independent continuant that is not a spatial region & b specifically depends on c"@en ;
                                             skos:example "A shape inheres in a shaped object; a mass inheres in a material entity"@en .

<http://purl.obolibrary.org/obo/BFO_0000019> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
                                             dc11:identifier "055-BFO" ;
                                             rdfs:label "quality"@en ;
                                             skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en ;
                                             skos:example "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en .

<https://www.commoncoreontologies.org/ont00000345> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
                                                   rdfs:label "Act of Measuring"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en ;
                                                   <http://www.w3.org/2004/02/skos/core#example> "putting an object on a scale to measure its weight in kilograms" ,
                                                                                                 "rating Hollywood movies on a 1 to 5 star scale" ,
                                                                                                 "using a tape measure to determine the height and width of a doorway in inches" ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

#=======================
# Classes
#=======================

<http://example.org/OntologyTradecraft/core/AerospaceEngineerRole> a owl:Class ;
    rdfs:label "Aerospace Engineer Role"@en ;
    skos:definition "A role that inheres in an agent and is realized in an Act of Aircraft Processing."@en ;
    rdfs:subClassOf obo:BFO_0000023 . #role

<http://example.org/OntologyTradecraft/core/ActOfAircraftProcessing> a owl:Class ;
    rdfs:label "Act of Aircraft Processing"@en ;
    skos:definition "An Act of Artifact Processing in which some agent designs, constructs, or tests an aircraft, missile, or spacecraft as prescribed by some Artifact Design."@en ;
    rdfs:subClassOf cco:ont00000908 . #Act of Artifact Processing

<http://example.org/OntologyTradecraft/core/InternationalCivilAviationOrganizationCode> a owl:Class ;
    rdfs:label "International Civil Aviation Organization Code"@en ;
    skos:altLabel "ICAO Code"@en ;
    skos:definition "A Code Identifier that designates an airport, airline, or aircraft type in accordance with the standards set by the International Civil Aviation Organization (ICAO)."@en ;
    rdfs:subClassOf cco:ont00000077 . #Code Identifier

<http://example.org/OntologyTradecraft/core/FederalAviationAdministrationDesignator> a owl:Class ;
    rdfs:label "Federal Aviation Administration Designator"@en ;
    skos:altLabel "FAA Designator"@en ;
    skos:definition "A Code Identifier that designates an aircraft model in accordance with the standards set by the Federal Aviation Administration (FAA)."@en ;
    rdfs:subClassOf cco:ont00000077 . #Code Identifier

<http://example.org/OntologyTradecraft/core/ManufacturerRole> a owl:Class ;
    rdfs:label "Manufacturer Role"@en ;
    skos:definition "A role that inheres in an agent and is realized in an Act of Manufacturing."@en ;
    rdfs:subClassOf obo:BFO_0000023 . #role
    
<http://example.org/OntologyTradecraft/core/AircraftSpecification> a owl:Class ;
    rdfs:label "Aircraft Specification"@en ;
    skos:definition "An Artifact Design that prescribes the design and performance characteristics of an aircraft."@en ;
    rdfs:subClassOf cco:ont00000319 . #Artifact Design
<http://example.org/OntologyTradecraft/core/JetSpecification> a owl:Class ;
    rdfs:label "Jet Specification"@en ;
    skos:definition "An Aircraft Specification that prescribes the design and performance characteristics of a jet."@en ;
    rdfs:subClassOf :AircraftSpecification .

<http://example.org/OntologyTradecraft/core/Jet> a owl:Class ;
    rdfs:label "Jet"@en ;
    skos:definition "A Fixed Wing Aircraft that is powered by one or more jet engines."@en ;
    rdfs:subClassOf :FixedWing . 

<http://example.org/OntologyTradecraft/core/AircraftApproachCategory> a owl:Class ;
    rdfs:label "Aircraft Approach Category"@en ;
    skos:definition "A Nominal Measurement Information Content Entity that categorizes an aircraft according to its approach speed."@en ;
    rdfs:subClassOf cco:ont00000293 . #Nominal Measurement Information Content Entity

<http://example.org/OntologyTradecraft/core/AircraftDesignGroup> a owl:Class ;
    rdfs:label "Aircraft Design Group"@en ;
    skos:definition "A Nominal Measurement Information Content Entity that categorizes an aircraft according to its combination of Tail Height and Wingspan."@en ;
    rdfs:subClassOf cco:ont00000293 . #Nominal Measurement Information Content Entity

<http://example.org/OntologyTradecraft/core/ActOfAircraftOperation> a owl:Class ;
    rdfs:label "Act of Aircraft Operation"@en ;
    skos:definition "An Act of Vehicle Use in which an aircraft is operated for a specific purpose, such as takeoff, landing, or taxiing."@en ;
    rdfs:subClassOf cco:ont00000515 . #Act of Vehicle Use
<http://example.org/OntologyTradecraft/core/AircraftApproach> a owl:Class ;
    rdfs:label "Aircraft Approach"@en ;
    skos:definition "An Act of Aircraft Operation in which an aircraft approaches a runway for landing."@en ;
    rdfs:subClassOf :ActOfAircraftOperation .

<http://example.org/OntologyTradecraft/core/ActOfAircraftProcessing> a owl:Class ;
    rdfs:label "Act of Aircraft Processing"@en ;
    skos:definition "An Act of Artifact Processing in which an aircraft is designed, constructed, or tested."@en ;
    rdfs:subClassOf cco:ont00000908 . #Act of Artifact Processing

<http://example.org/OntologyTradecraft/core/AircraftTestingProcess> a owl:Class ;
    rdfs:label "Test Process"@en ;
    skos:definition "An Act of Aircraft Processing in which an aircraft is tested."@en ;
    rdfs:subClassOf :ActOfAircraftProcessing .

<http://example.org/OntologyTradecraft/core/ActOfAircraftDesign> a owl:Class ;
    rdfs:label "Act of Aircraft Design"@en ;
    skos:definition "An Act of Aircraft Processing in which an aircraft is designed according to an Aircraft Specification."@en ;
    rdfs:subClassOf :ActOfAircraftProcessing ;
    owl:equivalentClass [ 
        a owl:Class ;
        owl:intersectionOf ( 
            :ActOfAircraftProcessing
            [ 
                a owl:Restriction ;
                owl:onProperty cco:ont00001920 ; #prescribed by
                owl:someValuesFrom :AircraftSpecification 
            ] 
        ) 
    ] .

<http://example.org/OntologyTradecraft/core/AircraftManufacturer> a owl:Class ;
    rdfs:label "Aircraft Manufacturer"@en ;
    skos:definition "A Commercial Organization that bears some Manufacturer Role and is agent in some Act of Aircraft Processing."@en ;
    rdfs:subClassOf cco:ont00000443 ; #Commercial Organization
    owl:equivalentClass [ 
        a owl:Class ;
        owl:intersectionOf ( 
            cco:ont00000443
            [ 
                a owl:Restriction ;
                owl:onProperty obo:BFO_0000196 ; #bearer of
                owl:someValuesFrom :ManufacturerRole 
            ]
            [ 
                a owl:Restriction ;
                owl:onProperty cco:ont00001787 ; #agent in
                owl:someValuesFrom :ActOfAircraftProcessing 
            ]
        ) 
    ] .

<http://example.org/OntologyTradecraft/core/FixedWing> a owl:Class ;
    rdfs:label "Fixed Wing"@en ;
    skos:definition "An Aircraft that generates lift primarily through the use of stationary wings."@en ;
    rdfs:subClassOf cco:ont00001043 . #Aircraft

<http://example.org/OntologyTradecraft/core/AdapabilityEvaluation> a owl:Class ;
    rdfs:label "Adaptability Evaluation"@en ;
    skos:definition "An Act of Appraisal in which some material or equipment used in aircraft design or manufacturing is evaluated by some Agent." ;
    rdfs:subClassOf cco:ont00000636 .

<http://example.org/OntologyTradecraft/core/AerospaceEngineerRole> a owl:Class ;
    rdfs:label "Aerospace Engineer Role"@en ;
    skos:definition "An Occupation Role that inheres in an Agent who is responsible for designing, constructing, and testing aircraft, missiles, and spacecraft."@en ;
    rdfs:subClassOf cco:ont00000984 .

<http://example.org/OntologyTradecraft/core/AerospaceOperationsTechnologistRole> a owl:Class ;
    rdfs:label "Aerospace Operations Technologist Role"@en ;
    skos:definition "An Aerospace Engineer Role that inheres in an Agent who is responsible for operating instruments and equipment aboard air and space vehicles." ;
    rdfs:subClassOf :AerospaceEngineerRole .

<http://example.org/OntologyTradecraft/core/AerospaceTechnicianRole> a owl:Class ;
    rdfs:label "Aerospace Technician Role"@en ;
    skos:definition "An Aerospace Engineer Role that inheres in an Agent who is responsible for installing, adjusting and maintaining instruments and equipment aboard air and space vehicles." ;
    rdfs:subClassOf :AerospaceEngineerRole .


#=======================
# Object Properties
#=======================
<http://example.org/OntologyTradecraft/core/hasManufacturer> a owl:ObjectProperty ;
    rdfs:label "has manufacturer"@en ;
    skos:definition "An object property that relates an aircraft to its manufacturer, which is the agent responsible for designing and producing the aircraft."@en ;
    rdfs:domain :AircraftSpecification ;
    rdfs:range :ManufacturerRole .



#=======================
# Datatype Properties
#=======================
<http://example.org/OntologyTradecraft/core/hasLengthInFeet> a owl:DatatypeProperty ;
    rdfs:label "has Length Ft"@en ;
    skos:definition "A datatype property that relates an aircraft to its length value in feet."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range xsd:decimal .

<http://example.org/OntologyTradecraft/core/hasTailHeightInFeet> a owl:DatatypeProperty ;
    rdfs:label "has Tail Height Ft"@en ;
    skos:definition "A datatype property that relates an aircraft to its tail height value in feet."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range xsd:decimal .

<http://example.org/OntologyTradecraft/core/hasICAOCode> a owl:DatatypeProperty ;
    rdfs:label "has ICAO code"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding International Civil Aviation Organization (ICAO) code, which is a unique identifier for the aircraft type."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range xsd:string .

<http://example.org/OntologyTradecraft/core/hasModelBADA> a owl:DatatypeProperty ;
    rdfs:label "has Model BADA"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding BADA model name, which is a performance model used for aircraft performance analysis."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range xsd:string .

<http://example.org/OntologyTradecraft/core/hasModelFAA> a owl:DatatypeProperty ;
    rdfs:label "has Model FAA"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding FAA model name, which is a performance model used for aircraft performance analysis."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range xsd:string .

<http://example.org/OntologyTradecraft/core/hasFAADesignator> a owl:DatatypeProperty ;
    rdfs:label "has FAA designator"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding FAA designator, which is a unique identifier for the aircraft type."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range xsd:string .

<http://example.org/OntologyTradecraft/core/hasAAC> a owl:DatatypeProperty ;
    rdfs:label "has AAC"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding Aircraft Approach Category (AAC) value."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range [ 
        a rdfs:Datatype ;
        owl:oneOf ("A" "B" "C" "D" "E") 
        ] .

<http://example.org/OntologyTradecraft/core/hasAACMinimum> a owl:DatatypeProperty ;
    rdfs:label "has AAC minimum"@en ;
    skos:definition "A datatype property that relates an aircraft to its corresponding minimum Aircraft Approach Category (AAC) value."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range [ 
        a rdfs:Datatype ;
        owl:oneOf ("A" "B" "C" "D" "E") 
        ] .

<http://example.org/OntologyTradecraft/core/hasAACMaximum> a owl:DatatypeProperty ;
    rdfs:label "has AAC maximum" ;
    skos:definition "A datatype property that relates an aircraft to its corresponding maximum Aircraft Approach Category (AAC) value." ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range [ 
        a rdfs:Datatype ;
        owl:oneOf ("A" "B" "C" "D" "E") 
        ] .

<http://example.org/OntologyTradecraft/core/hasTailHeightAtOEWInFeet> a owl:DatatypeProperty ;
    rdfs:label "has tail height at OEW in feet"@en ;
    skos:prefLabel "has Tail Height at OEW Ft"@en ;
    skos:definition "A datatype property that relates an aircraft to its Tail Height value at Operating Empty Weight (OEW) in feet."@en ;
    rdfs:domain cco:ont00001043 ; #Aircraft
    rdfs:range xsd:decimal .

<http://example.org/OntologyTradecraft/core/hasWheelbaseInFeet> a owl:DatatypeProperty ;
    rdfs:label "has wheelbase"@en ;
    skos:definition "A datatype property that relates an aircraft to its Wheelbase value in feet."@en ;
