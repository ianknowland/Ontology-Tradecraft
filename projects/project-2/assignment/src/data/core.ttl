#=======================
# Annotation Properties
#=======================

<http://example.org/OntologyTradecraft/core/Remarks> a owl:AnnotationProperty ;
    rdfs:label "remarks"@en ;
    skos:definition "An annotation property that provides additional information or comments about an entity."@en ;
    rdfs:domain obo:BFO_0000001 ; #Entity
    rdfs:range xsd:string .