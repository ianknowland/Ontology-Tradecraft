###  http://example.org/OntologyTradecraft/core/hasLastUpdate
:hasLastUpdate rdf:type owl:DatatypeProperty ;
               rdfs:domain :AircraftSpecification ;
               rdfs:range xsd:date ;
               rdfs:label "has last update"@en ;
               skos:definition "A datatype property that relates an aircraft specification to the date of its last update."@en .


###  http://example.org/OntologyTradecraft/core/hasLengthInFeet
:hasLengthInFeet rdf:type owl:DatatypeProperty ;
                 rdfs:domain cco:ont00001043 ;
                 rdfs:range xsd:decimal ;
                 rdfs:label "has Length Ft"@en ;
                 skos:definition "A datatype property that relates an aircraft to its length value in feet."@en .


###  http://example.org/OntologyTradecraft/core/hasMainGearConfiguration
:hasMainGearConfiguration rdf:type owl:DatatypeProperty ;
                          rdfs:domain cco:ont00001043 ;
                          rdfs:range xsd:string ;
                          rdfs:label "has main gear configuration"@en ;
                          skos:definition "A datatype property that relates an aircraft to its main gear configuration, which describes the arrangement of the main landing gear."@en .


###  http://example.org/OntologyTradecraft/core/hasMainGearWidthInFeet
