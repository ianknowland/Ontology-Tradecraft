#################################################################
#    Classes
#################################################################

###  http://example.org/OntologyTradecraft/core/ActOfAircraftDesign
:ActOfAircraftDesign rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :ActOfAircraftProcessing
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cco:ont00001920 ;
                                                                  owl:someValuesFrom :AircraftSpecification
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf :ActOfAircraftProcessing ;
                     rdfs:label "Act of Aircraft Design"@en ;
                     skos:definition "An Act of Aircraft Processing in which an aircraft is designed according to an Aircraft Specification."@en .


###  http://example.org/OntologyTradecraft/core/ActOfAircraftOperation
:ActOfAircraftOperation rdf:type owl:Class ;
                        rdfs:subClassOf cco:ont00000515 ;
                        rdfs:label "Act of Aircraft Operation"@en ;
                        skos:definition "An Act of Vehicle Use in which an aircraft is operated for a specific purpose, such as takeoff, landing, or taxiing."@en .


###  http://example.org/OntologyTradecraft/core/ActOfAircraftProcessing
:ActOfAircraftProcessing rdf:type owl:Class ;
                         rdfs:subClassOf cco:ont00000908 ;
                         rdfs:label "Act of Aircraft Processing"@en ;
                         skos:definition "An Act of Artifact Processing in which an aircraft is designed, constructed, or tested."@en ,
                                         "An Act of Artifact Processing in which some agent designs, constructs, or tests an aircraft, missile, or spacecraft as prescribed by some Artifact Design."@en .


###  http://example.org/OntologyTradecraft/core/AdapabilityEvaluation
:AdapabilityEvaluation rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000636 ;
                       rdfs:label "Adaptability Evaluation"@en ;
                       skos:definition "An Act of Appraisal in which some material or equipment used in aircraft design or manufacturing is evaluated by some Agent." .


###  http://example.org/OntologyTradecraft/core/AerospaceEngineerRole
:AerospaceEngineerRole rdf:type owl:Class ;
                       rdfs:subClassOf obo:BFO_0000023 ,
                                       cco:ont00000984 ;
                       rdfs:label "Aerospace Engineer Role"@en ;
                       skos:definition "A role that inheres in an agent and is realized in an Act of Aircraft Processing."@en ,
                                       "An Occupation Role that inheres in an Agent who is responsible for designing, constructing, and testing aircraft, missiles, and spacecraft."@en .


###  http://example.org/OntologyTradecraft/core/AerospaceOperationsTechnologistRole
:AerospaceOperationsTechnologistRole rdf:type owl:Class ;
                                     rdfs:subClassOf :AerospaceEngineerRole ;
                                     rdfs:label "Aerospace Operations Technologist Role"@en ;
                                     skos:definition "An Aerospace Engineer Role that inheres in an Agent who is responsible for operating instruments and equipment aboard air and space vehicles." .


###  http://example.org/OntologyTradecraft/core/AerospaceTechnicianRole
:AerospaceTechnicianRole rdf:type owl:Class ;
                         rdfs:subClassOf :AerospaceEngineerRole ;
                         rdfs:label "Aerospace Technician Role"@en ;
                         skos:definition "An Aerospace Engineer Role that inheres in an Agent who is responsible for installing, adjusting and maintaining instruments and equipment aboard air and space vehicles." .


###  http://example.org/OntologyTradecraft/core/AircraftApproach
:AircraftApproach rdf:type owl:Class ;
                  rdfs:subClassOf :ActOfAircraftOperation ;
                  rdfs:label "Aircraft Approach"@en ;
                  skos:definition "An Act of Aircraft Operation in which an aircraft approaches a runway for landing."@en .


###  http://example.org/OntologyTradecraft/core/AircraftApproachCategory
:AircraftApproachCategory rdf:type owl:Class ;
                          rdfs:subClassOf cco:ont00000293 ;
                          rdfs:label "Aircraft Approach Category"@en ;
                          skos:definition "A Nominal Measurement Information Content Entity that categorizes an aircraft according to its approach speed."@en .


###  http://example.org/OntologyTradecraft/core/AircraftDesignGroup
:AircraftDesignGroup rdf:type owl:Class ;
                     rdfs:subClassOf cco:ont00000293 ;
                     rdfs:label "Aircraft Design Group"@en ;
                     skos:definition "A Nominal Measurement Information Content Entity that categorizes an aircraft according to its combination of Tail Height and Wingspan."@en .


###  http://example.org/OntologyTradecraft/core/AircraftManufacturer
:AircraftManufacturer rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( cco:ont00000443
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty obo:BFO_0000196 ;
                                                                   owl:someValuesFrom :ManufacturerRole
                                                                 ]
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty cco:ont00001787 ;
                                                                   owl:someValuesFrom :ActOfAircraftProcessing
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf cco:ont00000443 ;
                      rdfs:label "Aircraft Manufacturer"@en ;
                      skos:definition "A Commercial Organization that bears some Manufacturer Role and is agent in some Act of Aircraft Processing."@en .


###  http://example.org/OntologyTradecraft/core/AircraftSpecification
:AircraftSpecification rdf:type owl:Class ;
                       rdfs:subClassOf cco:ont00000319 ;
                       rdfs:label "Aircraft Specification"@en ;
                       skos:definition "An Artifact Design that prescribes the design and performance characteristics of an aircraft."@en .


###  http://example.org/OntologyTradecraft/core/AircraftTestingProcess
:AircraftTestingProcess rdf:type owl:Class ;
                        rdfs:subClassOf :ActOfAircraftProcessing ;
                        rdfs:label "Test Process"@en ;
                        skos:definition "An Act of Aircraft Processing in which an aircraft is tested."@en .


###  http://example.org/OntologyTradecraft/core/FederalAviationAdministrationDesignator
:FederalAviationAdministrationDesignator rdf:type owl:Class ;
                                         rdfs:subClassOf cco:ont00000077 ;
                                         rdfs:label "Federal Aviation Administration Designator"@en ;
                                         skos:altLabel "FAA Designator"@en ;
                                         skos:definition "A Code Identifier that designates an aircraft model in accordance with the standards set by the Federal Aviation Administration (FAA)."@en .


###  http://example.org/OntologyTradecraft/core/FixedWing
:FixedWing rdf:type owl:Class ;
           rdfs:subClassOf cco:ont00001043 ;
           rdfs:label "Fixed Wing"@en ;
           skos:definition "An Aircraft that generates lift primarily through the use of stationary wings."@en .


###  http://example.org/OntologyTradecraft/core/InternationalCivilAviationOrganizationCode
:InternationalCivilAviationOrganizationCode rdf:type owl:Class ;
                                            rdfs:subClassOf cco:ont00000077 ;
                                            rdfs:label "International Civil Aviation Organization Code"@en ;
                                            skos:altLabel "ICAO Code"@en ;
                                            skos:definition "A Code Identifier that designates an airport, airline, or aircraft type in accordance with the standards set by the International Civil Aviation Organization (ICAO)."@en .


###  http://example.org/OntologyTradecraft/core/Jet
:Jet rdf:type owl:Class ;
     rdfs:subClassOf :FixedWing ;
     rdfs:label "Jet"@en ;
     skos:definition "A Fixed Wing Aircraft that is powered by one or more jet engines."@en .


###  http://example.org/OntologyTradecraft/core/JetSpecification
:JetSpecification rdf:type owl:Class ;
                  rdfs:subClassOf :AircraftSpecification ;
                  rdfs:label "Jet Specification"@en ;
                  skos:definition "An Aircraft Specification that prescribes the design and performance characteristics of a jet."@en .


###  http://example.org/OntologyTradecraft/core/ManufacturerRole
:ManufacturerRole rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000023 ;
                  rdfs:label "Manufacturer Role"@en ;
                  skos:definition "A role that inheres in an agent and is realized in an Act of Manufacturing."@en .


###  http://purl.obolibrary.org/obo/BFO_0000019
obo:BFO_0000019 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000020 ;
                <http://purl.org/dc/elements/1.1/identifier> "055-BFO" ;
                rdfs:label "quality"@en ;
                skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en ;
                skos:example "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en .


###  https://www.commoncoreontologies.org/ont00000120
cco:ont00000120 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000853 ;
                rdfs:label "Measurement Unit"@en ;
                skos:definition "A Descriptive Information Content Entity that describes a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Unit_of_measurement&oldid=1061038125"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000319
cco:ont00000319 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000965 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cco:ont00001942 ;
                                  owl:someValuesFrom cco:ont00000995
                                ] ;
                rdfs:label "Artifact Design"@en ;
                skos:definition "A Prescriptive Information Content Entity that is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of primitive components, satisfying a set of requirements, subject to constraints."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Design&oldid=1063941625"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000345
cco:ont00000345 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000228 ;
                rdfs:label "Act of Measuring"@en ;
                skos:definition "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en ;
                skos:example "putting an object on a scale to measure its weight in kilograms" ,
                             "rating Hollywood movies on a 1 to 5 star scale" ,
                             "using a tape measure to determine the height and width of a doorway in inches" ;
                cco:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000533
cco:ont00000533 rdf:type owl:Class ;
                rdfs:subClassOf cco:ont00000056 ;
                rdfs:label "Jet Engine"@en ;
                skos:definition "A Reaction Engine that discharges a fast moving jet that generates Thrust by jet propulsion."@en ;
                skos:scopeNote "Some (most) jet engines utilize turbines, but some do not. Most rocket engines do not utilize turbines, but some do."@en ;
                cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Jet_engine&oldid=1060157063"^^xsd:anyURI ;
                cco:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


