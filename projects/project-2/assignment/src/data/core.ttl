                             skos:definition "A datatype property that relates an information content entity to a string denoting an annual 90th percentile wage."@en .


###  http://example.org/OntologyTradecraft/core/hasApproachSpeedInKnots
:hasApproachSpeedInKnots rdf:type owl:DatatypeProperty ;
                         rdfs:domain cco:ont00001043 ;
                         rdfs:range xsd:integer ;
                         rdfs:label "has approach speed in knots"@en ;
                         skos:definition "A datatype property that relates an aircraft to its approach speed value in knots."@en .


###  http://example.org/OntologyTradecraft/core/hasApproachSpeedMaximumInKnots
:hasApproachSpeedMaximumInKnots rdf:type owl:DatatypeProperty ;
                                rdfs:domain cco:ont00001043 ;
                                rdfs:range xsd:integer ;
                                rdfs:label "has approach speed maximum in knots"@en ;
                                skos:definition "A datatype property that relates an aircraft to its maximum approach speed value in knots."@en .


###  http://example.org/OntologyTradecraft/core/hasApproachSpeedMinimumInKnots
:hasApproachSpeedMinimumInKnots rdf:type owl:DatatypeProperty ;
                                rdfs:domain cco:ont00001043 ;
                                rdfs:range xsd:integer ;
                                rdfs:label "has approach speed minimum in knots"@en ;
                                skos:definition "A datatype property that relates an aircraft to its minimum approach speed value in knots."@en .


###  http://example.org/OntologyTradecraft/core/hasArea
:hasArea rdf:type owl:DatatypeProperty ;
         rdfs:label "has area"@en ;
         skos:definition "A datatype property that relates an information content entity to a code denoting some geospatial region."@en .


###  http://example.org/OntologyTradecraft/core/hasAreaTitle
:hasAreaTitle rdf:type owl:DatatypeProperty ;
              rdfs:label "has area title"@en ;
              skos:definition "A datatype property that relates an information content entity to a string denoting the name of an area."@en .


###  http://example.org/OntologyTradecraft/core/hasAreaType
:hasAreaType rdf:type owl:DatatypeProperty ;
             rdfs:label "has area type"@en ;
             skos:definition "A datatype property that relates an information content entity to a string denoting an area type."@en .


###  http://example.org/OntologyTradecraft/core/hasCockpitToMainGearDistanceInFeet
:hasCockpitToMainGearDistanceInFeet rdf:type owl:DatatypeProperty ;
                                    rdfs:domain cco:ont00001043 ;
                                    rdfs:range xsd:decimal ;
                                    rdfs:label "has cockpit to main gear distance"@en ;
                                    skos:definition "A datatype property that relates an aircraft to the distance between the cockpit and the main gear in feet."@en .


###  http://example.org/OntologyTradecraft/core/hasConsolidatedWeightTurbulenceCategory
:hasConsolidatedWeightTurbulenceCategory rdf:type owl:DatatypeProperty ;
                                         rdfs:domain cco:ont00001043 ;
                                         rdfs:range [ rdf:type rdfs:Datatype ;
                                                      owl:oneOf [ rdf:type rdf:List ;
                                                                  rdf:first "A" ;
                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                             rdf:first "B" ;
                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                        rdf:first "C" ;
                                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                                   rdf:first "D" ;
                                                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                                                              rdf:first "E" ;
                                                                                                              rdf:rest [ rdf:type rdf:List ;
                                                                                                                         rdf:first "F" ;
                                                                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                                                                    rdf:first "G" ;
                                                                                                                                    rdf:rest [ rdf:type rdf:List ;
                                                                                                                                               rdf:first "H" ;
                                                                                                                                               rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                          rdf:first "I" ;
                                                                                                                                                          rdf:rest rdf:nil
                                                                                                                                                        ]
                                                                                                                                             ]
                                                                                                                                  ]
                                                                                                                       ]
                                                                                                            ]
                                                                                                 ]
                                                                                      ]
                                                                           ]
                                                                ]
                                                    ] ;
                                         rdfs:label "has consolidated weight turbulence category"@en ;
                                         skos:definition "A datatype property that relates an aircraft to its corresponding consolidated weight turbulence category."@en .


###  http://example.org/OntologyTradecraft/core/hasEmploymentPRSE
:hasEmploymentPRSE rdf:type owl:DatatypeProperty ;
                   rdfs:label "has employment PRSE"@en ;
                   skos:definition "A datatype property that relates an information content entity to a string denoting the percent relative standard error (PRSE) for an employment estimate."@en .


###  http://example.org/OntologyTradecraft/core/hasFAADesignator
:hasFAADesignator rdf:type owl:DatatypeProperty ;
                  rdfs:domain cco:ont00001043 ;
                  rdfs:range xsd:string ;
                  rdfs:label "has FAA designator"@en ;
                  skos:definition "A datatype property that relates an aircraft to its corresponding FAA designator, which is a unique identifier for the aircraft type."@en .


###  http://example.org/OntologyTradecraft/core/hasFAAWeightCategory
:hasFAAWeightCategory rdf:type owl:DatatypeProperty ;
                      rdfs:domain cco:ont00001043 ;
                      rdfs:range [ rdf:type rdfs:Datatype ;
                                   owl:oneOf [ rdf:type rdf:List ;
                                               rdf:first "Heavy" ;
                                               rdf:rest [ rdf:type rdf:List ;
                                                          rdf:first "Large" ;
                                                          rdf:rest [ rdf:type rdf:List ;
                                                                     rdf:first "Small" ;
                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                rdf:first "Small+" ;
                                                                                rdf:rest [ rdf:type rdf:List ;
                                                                                           rdf:first "Super" ;
                                                                                           rdf:rest rdf:nil
                                                                                         ]
                                                                              ]
                                                                   ]
                                                        ]
                                             ]
                                 ] ;
                      rdfs:label "has FAA weight"@en ;
                      skos:definition "A datatype property that relates an aircraft to its corresponding FAA weight category."@en .


