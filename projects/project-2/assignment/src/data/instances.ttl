                                skos:definition "The Occupational Employment and Wage Statistics survey that took place in May 2024."@en ;
                                cco:ont00001986 :OCC_WageDocument01 .


###  http://example.org/OntologyTradecraft/instances/OCC_17-2010_Entry
:OCC_17-2010_Entry rdf:type owl:NamedIndividual ,
                            cco:ont00002037 ;
                   cco:ont00001808 :OCC_role01 ;
                   p2o:hasAnnual10thPercentileWage 85350 ;
                   p2o:hasAnnual25thPercentileWage 104740 ;
                   p2o:hasAnnual75thPercentileWage 174480 ;
                   p2o:hasAnnual90thPercentileWage 205850 ;
                   p2o:hasArea "99" ;
                   p2o:hasAreaTitle "U.S." ;
                   p2o:hasAreaType "1" ;
                   p2o:hasEmploymentPRSE 2.3 ;
                   p2o:hasHourly10thPercentileWage 41.04 ;
                   p2o:hasHourly25thPercentileWage 50.36 ;
                   p2o:hasHourly75thPercentileWage 83.88 ;
                   p2o:hasHourly90thPercentileWage 98.97 ;
                   p2o:hasIGroup "cross-industry" ;
                   p2o:hasMeanAnnualWage 141180 ;
                   p2o:hasMeanHourlyWage 67.88 ;
                   p2o:hasMeanPRSE 0.8 ;
                   p2o:hasMedianAnnualWage 134830 ;
                   p2o:hasMedianHourlyWage 64.82 ;
                   p2o:hasNAICSCode "000000" ;
                   p2o:hasNAICSTitle "Cross-industry" ;
                   p2o:hasOCCCode "17-2010" ;
                   p2o:hasOCCTitle "Aerospace Engineers" ;
                   p2o:hasOGroup "broad" ;
                   p2o:hasOwnCode "1235" ;
                   p2o:hasPrimaryState "US" ;
                   p2o:hasTotalEmployees 68,440 ;
                   rdfs:label "OCC 17-2010 Entry"@en ;
                   skos:definition "The entry on row 179 of national_M2024_dl."@en .


