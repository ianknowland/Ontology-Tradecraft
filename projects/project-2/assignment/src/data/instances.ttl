###  http://example.org/OntologyTradecraft/core/AerospaceEngineerRole
p2o:AerospaceEngineerRole rdf:type owl:NamedIndividual .


###  http://example.org/OntologyTradecraft/instances/AerospaceEngineerPopulation
:AerospaceEngineerPopulation rdf:type owl:NamedIndividual ,
                                      cco:ont00000914 ;
                             obo:BFO_0000176 :USPopulation ;
                             rdfs:label "Aerospace Engineer Population"@en ;
                             skos:definition "The group of people that constitution the portion of the United States population that are Aerospace Engineers at any given time."@en .


###  http://example.org/OntologyTradecraft/instances/Airbus
:Airbus rdf:type owl:NamedIndividual ,
                 p2o:AircraftManufacturer ;
        rdfs:label "Airbus"@en ;
        skos:definition "A European aerospace corporation and manufacturer of aircraft and spacecraft in commercial, private, and military domains."@en .


###  http://example.org/OntologyTradecraft/instances/AirbusA320NSpecification
:AirbusA320NSpecification rdf:type owl:NamedIndividual ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cco:ont00001808 ;
                                     owl:allValuesFrom [ owl:intersectionOf ( p2o:FixedWing
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty p2o:hasManufacturer ;
                                                                                owl:hasValue :Airbus
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty obo:BFO_0000178 ;
                                                                                owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                                owl:onClass cco:ont00000533
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty p2o:hasLengthInFeet ;
                                                                                owl:hasValue 123.3
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty p2o:hasModelBADA ;
                                                                                owl:hasValue "Airbus A320-271N"
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty p2o:hasModelFAA ;
                                                                                owl:hasValue "Airbus A320 NEO"
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty p2o:hasTailHeightInFeet ;
                                                                                owl:hasValue 39.6
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ]
                                   ] ;
                          rdfs:label "Airbus A320 NEO"@en ;
                          skos:definition "The individual jet specification for an Airbus A320 Neo."@en .


###  http://example.org/OntologyTradecraft/instances/AirbusA320N_01
:AirbusA320N_01 rdf:type owl:NamedIndividual ,
                         p2o:FixedWing ;
                p2o:hasManufacturer :Airbus ;
                obo:BFO_0000178 :AirbusA320N_JetEngine_01 ,
                                :AirbusA320N_JetEngine_02 ;
                p2o:hasAAC "C" ;
                p2o:hasAircraftDesignGroup "III" ;
                p2o:hasApproachSpeedInKnots 137 ;
                p2o:hasCockpitToMainGearDistanceInFeet 50.2 ;
                p2o:hasConsolidatedWeightTurbulenceCategory "F" ;
                p2o:hasFAADesignator "A20N" ;
                p2o:hasFAAWeightCategory "Large" ;
                p2o:hasICAOCode "A20N" ;
                p2o:hasICAOWeightTurbulenceCategory "Medium" ;
                p2o:hasLAHSOGroup "7" ;
                p2o:hasLengthInFeet 123.3 ;
                p2o:hasMainGearConfiguration "D" ;
                p2o:hasMainGearWidthInFeet 29.4 ;
                p2o:hasMaximumAllowableLandingWeightInPounds 148591 ;
                p2o:hasMaximumTakeoffGrossWeightInPounds 174165 ;
                p2o:hasModelBADA "Airbus A320-271 N" ;
                p2o:hasModelFAA "Airbus A320 Neo" ;
                p2o:hasNumberOfTMFSOperationsInFY24 540276 ;
                p2o:hasOneHalfWakeCategory "F" ;
                p2o:hasParkingAreaInSquareFeet 16358.3 ;
                p2o:hasRegistrationCount 147 ;
                p2o:hasSRSCategory "III" ;
                p2o:hasTailHeightInFeet 39.6 ;
                p2o:hasTaxiwayDesignGroup "3" ;
                p2o:hasTwoWakeCategoryAppendixA "D" ;
                p2o:hasTwoWakeCategoryAppendixB "D" ;
                p2o:hasWheelbaseInFeet 41.5 ;
                p2o:hasWingspanInFeetWithWingletsSharklets 117.5 ;
                p2o:onFAARegistry "true"^^xsd:boolean ;
                p2o:Remarks "AAC validated by Flight Standardization Board (FSB) report."@en ;
                rdfs:label "Airbus A320 Neo 01"@en ;
                skos:definition "An instance of the Airbus A320 Neo that matches the artifact design."@en ;
                cco:ont00001801 :AirbusA320NSpecification .


###  http://example.org/OntologyTradecraft/instances/AirbusA320N_JetEngine_01
:AirbusA320N_JetEngine_01 rdf:type owl:NamedIndividual ,
                                   cco:ont00000533 ;
                          rdfs:label "Jet Engine 01"@en ;
                          skos:definition "The first jet engine attached to Airbus A320 Neo 01."@en .


###  http://example.org/OntologyTradecraft/instances/AirbusA320N_JetEngine_02
